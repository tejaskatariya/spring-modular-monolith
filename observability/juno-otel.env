# Source this in the shell that runs juno:
#
#   source observability/juno-otel.env
#   juno run --once
#
# It has to be sourced rather than placed in .juno/.env. Juno reads no dotenv
# file of its own; the OpenTelemetry SDK inside the juno process reads these
# straight from the environment, and .juno/.env is only there for the plugin
# scripts to source themselves.

# Tempo's OTLP/HTTP receiver, published by observability/compose.yml.
# The SDK appends /v1/traces itself, so this is the base URL.
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OTEL_EXPORTER_OTLP_PROTOCOL is deliberately not set. Juno constructs the
# HTTP exporter class directly, so that variable is read by nobody and setting
# it changes nothing. HTTP/protobuf is the only protocol Juno speaks.

# Juno flushes batched spans before exiting. Against a stopped Tempo the SDK
# default makes that wait about 7 seconds; this keeps it near 1.
export OTEL_EXPORTER_OTLP_TIMEOUT=2
