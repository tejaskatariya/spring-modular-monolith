            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Where the money went",
      "datasource": {
        "type": "loki",
        "uid": "juno-loki"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "description": "Every combination of item, step and role, with what it cost. Sort any column. This is the breakdown the bar charts below summarise.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "juno-loki"
          },
          "expr": "sum by (itemId, stepId, role) (sum_over_time({job=\"juno\", event=\"runner.finished\"} | json | unwrap costUsd [$__range]))",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Cost",
              "itemId": "Item",
              "stepId": "Step",
              "role": "Role"
            },
            "indexByName": {
              "itemId": 0,
              "stepId": 1,
              "role": 2,
              "Value": 3
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Cost",
            "desc": true
          }
        ],
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Cost"
          ],
          "countRows": false,
          "enablePagination": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              },
              {
                "id": "max",
                "value": 2.5
              }
            ]
          }
        ]
      }
    },
