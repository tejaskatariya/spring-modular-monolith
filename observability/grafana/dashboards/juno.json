    {
      "id": 10,
      "type": "timeseries",
      "title": "Spend over time, by item",
      "datasource": {
        "type": "loki",
        "uid": "juno-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "description": "Cost per time bucket, stacked by item. Each bar covers one interval with no overlap.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "juno-loki"
          },
          "expr": "sum by (itemId) (sum_over_time({job=\"juno\", event=\"runner.finished\"} | json | unwrap costUsd [$__interval]))",
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "{{itemId}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "BOOK-1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
