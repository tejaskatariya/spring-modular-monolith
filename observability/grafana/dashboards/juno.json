    {
      "id": 5,
      "type": "stat",
      "title": "Rubric retries",
      "datasource": {
        "type": "loki",
        "uid": "juno-loki"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "description": "Rounds scored below their threshold. Each bought another generator and evaluator call.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "juno-loki"
          },
          "expr": "sum(count_over_time({job=\"juno\", event=\"score.computed\"} | json | converged=\"false\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": ""
