    {
      "id": 11,
      "type": "table",
      "title": "Traces (open one for the full waterfall)",
      "datasource": {
        "type": "tempo",
        "uid": "juno-tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "description": "One row per item run. The trace is the complete view of a single run; the tiles above are the totals across runs.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "juno-tempo"
          },
          "queryType": "traceql",
          "query": "{ span.juno.scope.kind = \"item\" }",
          "limit": 50,
          "spss": 5,
          "tableType": "traces"
        }
      ]
    }
