          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "juno-loki"
          },
          "expr": "sum by (itemId) (sum_over_time({job=\"juno\", event=\"runner.finished\"} | json | unwrap costUsd [$__range]))",
          "editorMode": "code",
