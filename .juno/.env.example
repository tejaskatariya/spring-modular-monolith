# Environment for the Juno example plugins.
#
# Copy this file to `.env` next to it (`.juno/.env` in a scaffolded repo) or
# export the variables in your shell. plugins/lib.py loads the sibling .env
# itself; variables already set in your environment always win. Juno reads
# none of the plugin variables below; it passes the process environment through
# to your scripts untouched. The OTEL_* block at the end is the exception: Juno
# reads those itself when telemetry is enabled in workflow.yaml.

# --- Linear (linear-poll, linear-set-lane, linear-comment, linear-create-stories)
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_KEY=ENG
# The lane whose cards start work, and the label that opts a card in.
JUNO_TRIGGER_LANE=Specifying
JUNO_MARKER_LABEL=juno

# --- Confluence (fetch-context)
# Leave CONFLUENCE_BASE_URL unset to run offline: the step still writes
# artifacts/<id>/context/external.md, saying no source was configured.
# CONFLUENCE_BASE_URL=https://your-team.atlassian.net
# CONFLUENCE_API_TOKEN=...
# The pages every item gets. A trigger that sets meta.confluencePageIds on an
# item overrides this for that item.
# CONFLUENCE_PAGE_IDS=123456,234567

# --- GitHub (git-open-pr uses the gh CLI, which reads this itself)
# GITHUB_TOKEN=ghp_...

# Do NOT set JUNO_CONTEXT, JUNO_ITEM_ID, JUNO_STATE, JUNO_STEP, JUNO_ROUND,
# JUNO_SCORE, JUNO_RUN_DIR, or JUNO_CURSOR here. Juno sets those itself on
# every hook/script invocation; JUNO_CONTEXT points at a JSON file in the run
# directory carrying the item, step, round, score, states, and meta.

# --- OpenTelemetry export (only read when telemetry.enabled is true in
# workflow.yaml). Any OTLP/HTTP endpoint works; see docs/OBSERVABILITY.md for
# a recipe per backend. These reach your scripts and the Claude CLI too,
# through the same environment passthrough.

# Langfuse cloud. AUTH is `echo -n "pk-lf-...:sk-lf-..." | base64`.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <AUTH>

# A local OpenTelemetry Collector, Jaeger, Grafana Alloy or Elastic.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
